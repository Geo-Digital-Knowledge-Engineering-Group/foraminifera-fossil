<owl:NamedIndividual rdf:about="#PORC_Q1">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_03"/>
  <hasAnswerLeadingTo rdf:resource="#PORC_Q1U"/>
  <hasAnswerLeadingTo rdf:resource="#PORC_Q2"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q1. Are true chambers separated by septa present?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q1</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Are true chambers separated by septa present?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Septalarla ayrılmış gerçek localar var mı?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ABSENT -&gt; PORC_Q1U</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PRESENT -&gt; PORC_Q2</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PORC_Q1U">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_19"/>
  <leadsToGenus rdf:resource="#Cornuspira"/>
  <leadsToGenus rdf:resource="#Nubecularia"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q1U. How is the undivided tube coiled and attached?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q1U</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How is the undivided tube coiled and attached?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bölünmemiş tüp nasıl sarılmış ve tutunmuş?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREE -&gt; GENUS:Cornuspira</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ATTACHED -&gt; GENUS:Nubecularia</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PORC_Q2">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_10"/>
  <hasAnswerLeadingTo rdf:resource="#PORC_Q3"/>
  <hasAnswerLeadingTo rdf:resource="#PORC_Q4"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q2. Are the chambers internally subdivided into chamberlets or secondary compartments?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q2</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Are the chambers internally subdivided into chamberlets or secondary compartments?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Localar içten locacıklara veya ikincil bölmelere ayrılmış mı?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SIMPLE -&gt; PORC_Q3</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SUBDIVIDED -&gt; PORC_Q4</answerValue>
</owl:NamedIndividual>

