  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the triserial arrangement continue into the adult part?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Triserial dizilim erişkin bölümde devam ediyor mu?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NONE -&gt; REDIRECT:CHECK_KARRERULINA_RELATED</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">* -&gt; AGG_Q5F</answerValue>
</owl:NamedIndividual>

