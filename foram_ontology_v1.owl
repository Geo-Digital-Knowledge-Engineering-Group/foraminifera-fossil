  <asksAboutCharacter rdf:resource="#CHR_05"/>
  <hasAnswerLeadingTo rdf:resource="#PORC_Q3A"/>
  <hasAnswerLeadingTo rdf:resource="#PORC_Q3B"/>
  <hasAnswerLeadingTo rdf:resource="#PORC_Q3C"/>
  <leadsToGenus rdf:resource="#Sigmoilina"/>
  <leadsToGenus rdf:resource="#Miliola"/>
  <hasAnswerLeadingTo rdf:resource="#PORC_Q3F"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q3. What is the chamber arrangement?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q3</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">What is the chamber arrangement?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loca dizilimi nasıl?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QUINQUELOCULINE -&gt; PORC_Q3A</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRILOCULINE -&gt; PORC_Q3B</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BILOCULINE -&gt; PORC_Q3C</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IRREGULAR_SERIAL -&gt; GENUS:Sigmoilina</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OTHER -&gt; GENUS:Miliola</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CYCLIC -&gt; PORC_Q3F</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PORC_Q3A">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_09"/>
  <hasAnswerLeadingTo rdf:resource="#PORC_Q3A1"/>
  <leadsToGenus rdf:resource="#Articulina"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q3A. What happens to the adult chambers?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q3A</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">What happens to the adult chambers?</questionTextEn>
