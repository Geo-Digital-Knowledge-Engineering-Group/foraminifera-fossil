<owl:NamedIndividual rdf:about="#STATE_PRESENT">
  <rdf:type rdf:resource="#ObservationState"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PRESENT</rdfs:label>
  <labelTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Var</labelTr>
  <modelingNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The character is clearly observable in the specimen.</modelingNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#STATE_ABSENT">
  <rdf:type rdf:resource="#ObservationState"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ABSENT</rdfs:label>
  <labelTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yok</labelTr>
  <modelingNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expected to be observable in the available section but clearly absent.</modelingNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#STATE_NOT_OBSERVABLE">
  <rdf:type rdf:resource="#ObservationState"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NOT_OBSERVABLE</rdfs:label>
  <labelTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gözlenemiyor</labelTr>
  <modelingNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cannot be reliably evaluated (section orientation, preservation, image quality, incomplete exposure). NOT_OBSERVABLE != ABSENT; must not exclude a genus.</modelingNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#STATE_UNCERTAIN">
  <rdf:type rdf:resource="#ObservationState"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UNCERTAIN</rdfs:label>
  <labelTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Emin değilim</labelTr>
  <modelingNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observed area visible but state cannot be confidently determined. Neutral score.</modelingNote>
</owl:NamedIndividual>

