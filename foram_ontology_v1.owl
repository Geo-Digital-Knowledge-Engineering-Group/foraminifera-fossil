  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">YES -&gt; GENUS:Psammosphaera</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NO -&gt; GENUS:Saccammina</answerValue>
</owl:NamedIndividual>

