  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Localar uzamış/şişe biçimli ve dar kaudal bağlantılı mı?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">YES -&gt; GENUS:Caudammina</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NO -&gt; GENUS:Reophax</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AGG_Q4E">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_11"/>
  <hasAnswerLeadingTo rdf:resource="#AGG_Q5C"/>
  <leadsToGenus rdf:resource="#Reticulophragmium"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4E. Are the chambers internally secondarily subdivided?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4E</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Are the chambers internally secondarily subdivided?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Localar içten ikincil bölmelere ayrılmış mı?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ABSENT -&gt; AGG_Q5C</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PRESENT -&gt; GENUS:Reticulophragmium</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AGG_Q5C">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_09"/>
  <leadsToGenus rdf:resource="#Haplophragmoides"/>
  <leadsToGenus rdf:resource="#Ammobaculites"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5C. Does the test remain planispiral throughout growth?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5C</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the test remain planispiral throughout growth?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kavkı büyüme boyunca planispiral kalıyor mu?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NONE -&gt; GENUS:Haplophragmoides</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLANISPIRAL_TO_UNISERIAL -&gt; GENUS:Ammobaculites</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AGG_Q4F">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_03"/>
  <leadsToGenus rdf:resource="#Recurvoides"/>
  <leadsToGenus rdf:resource="#Glomospira"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4F. Are true septa present?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4F</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Are true septa present?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gerçek septalar var mı?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PRESENT -&gt; GENUS:Recurvoides</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ABSENT -&gt; GENUS:Glomospira</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AGG_Q4G">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <leadsToGenus rdf:resource="#Trochammina"/>
  <hasAnswerLeadingTo rdf:resource="#AGG_Q5D"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4G. Is the test low trochospiral, with inflated chambers and distinct spiral/umbilical sides?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4G</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is the test low trochospiral, with inflated chambers and distinct spiral/umbilical sides?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kavkı alçak trokospiral, locaları şişkin ve spiral/umbilikal tarafları ayırt edilebilir mi?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">YES -&gt; GENUS:Trochammina</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NO -&gt; AGG_Q5D</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AGG_Q5D">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_09"/>
  <leadsToGenus rdf:resource="#Karrerulina"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5D. Does the early coiled/triserial part pass into a distinct elongate serial adult part?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5D</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the early coiled/triserial part pass into a distinct elongate serial adult part?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Erken sarılı/triserial bölüm belirgin uzamış seri erişkin bölüme geçiyor mu?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COILED_TO_SERIAL -&gt; GENUS:Karrerulina</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NONE -&gt; INDETERMINATE:TROCHOSPIRAL_AGGLUTINATED</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AGG_Q4H">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_09"/>
  <leadsToGenus rdf:resource="#Textularia"/>
  <hasAnswerLeadingTo rdf:resource="#AGG_Q5E"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4H. Is the observable test biserial from early to adult growth?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4H</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is the observable test biserial from early to adult growth?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gözlenebilen kavkı erken evreden erişkin evreye kadar biserial mi?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NONE -&gt; GENUS:Textularia</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">* -&gt; AGG_Q5E</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AGG_Q5E">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_09"/>
  <leadsToGenus rdf:resource="#Spiroplectammina"/>
  <hasAnswerLeadingTo rdf:resource="#AGG_Q6B"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5E. Is an early planispiral coiled part present?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5E</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is an early planispiral coiled part present?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Erken planispiral sarılmış bölüm var mı?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLANISPIRAL_TO_BISERIAL -&gt; GENUS:Spiroplectammina</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">* -&gt; AGG_Q6B</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AGG_Q6B">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_09"/>
  <hasAnswerLeadingTo rdf:resource="#AGG_Q7A"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6B. Is an early triserial part present?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6B</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is an early triserial part present?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Erken triserial bölüm var mı?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRISERIAL_TO_BISERIAL -&gt; AGG_Q7A</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">* -&gt; INDETERMINATE:BISERIAL_AGGLUTINATED</answerValue>
