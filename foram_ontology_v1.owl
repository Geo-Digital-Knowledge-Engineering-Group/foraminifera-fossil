<owl:NamedIndividual rdf:about="#AGG_Q1">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_03"/>
  <hasAnswerLeadingTo rdf:resource="#AGG_Q2A"/>
  <hasAnswerLeadingTo rdf:resource="#AGG_Q2B"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1. Are true septa separating distinct chambers present?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Are true septa separating distinct chambers present?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Belirgin locaları birbirinden ayıran gerçek septalar var mı?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ABSENT -&gt; AGG_Q2A</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PRESENT -&gt; AGG_Q2B</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AGG_Q2A">
