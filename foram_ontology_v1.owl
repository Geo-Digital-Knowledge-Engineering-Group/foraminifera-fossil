  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GLOBULAR -&gt; AGG_Q3A</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TUBULAR -&gt; AGG_Q3B</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TUBULAR -&gt; AGG_Q3C</answerValue>
</owl:NamedIndividual>

