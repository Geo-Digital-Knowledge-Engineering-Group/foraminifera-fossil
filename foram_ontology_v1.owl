  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the test have strong radial rays or a stellate outline?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kavkıda güçlü radyal ışınlar veya yıldızsı dış şekil var mı?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STELLATE -&gt; GENUS:Asterocyclina</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DISCOIDAL -&gt; HYA_Q4C</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HYA_Q4C">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <leadsToGenus rdf:resource="#Discocyclina"/>
  <hasAnswerLeadingTo rdf:resource="#HYA_Q5C"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4C. Are annular stolons visible between equatorial chamberlets?</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4C</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Are annular stolons visible between equatorial chamberlets?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ekvatoryal locacıklar arasında annular stolonlar görülüyor mu?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">YES -&gt; GENUS:Discocyclina</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NO -&gt; HYA_Q5C</answerValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HYA_Q5C">
  <rdf:type rdf:resource="#DecisionQuestion"/>
  <asksAboutCharacter rdf:resource="#CHR_12"/>
  <leadsToGenus rdf:resource="#Orbitoclypeus"/>
  <leadsToGenus rdf:resource="#Nemkovella"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5C. Examine the embryonic apparatus and equatorial chamberlets.</rdfs:label>
  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5C</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Examine the embryonic apparatus and equatorial chamberlets.</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Embriyonik aparat ve ekvatoryal locacıkları incele.</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COMPLEX -&gt; GENUS:Orbitoclypeus</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SIMPLE -&gt; GENUS:Nemkovella</answerValue>
</owl:NamedIndividual>

