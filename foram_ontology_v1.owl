  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is the test slender/elongate rather than robustly conical?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kavkı sağlam konik olmak yerine ince/uzamış mı?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ELONGATE -&gt; GENUS:Gaudryina</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CONICAL -&gt; GENUS:Dorothia</answerValue>
</owl:NamedIndividual>

