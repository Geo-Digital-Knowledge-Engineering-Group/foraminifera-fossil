  <questionCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3A</questionCode>
  <questionTextEn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Are lateral chambers / chamberlets developed above and below the equatorial layer?</questionTextEn>
  <questionTextTr rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ekvatoryal tabakanın üstünde ve altında lateral localar/locacıklar gelişmiş mi?</questionTextTr>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ABSENT -&gt; GENUS:Heterostegina</answerValue>
  <answerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PRESENT -&gt; GENUS:Spiroclypeus</answerValue>
</owl:NamedIndividual>

