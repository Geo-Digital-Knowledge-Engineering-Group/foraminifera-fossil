MATCH (c:Character {id: 'CHR_08'}), (v:Value {key: 'CHR_08_NOT_OBSERVABLE'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_08_UNCERTAIN'}) SET v.code = 'UNCERTAIN', v.character = 'CHR_08';
MATCH (c:Character {id: 'CHR_08'}), (v:Value {key: 'CHR_08_UNCERTAIN'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (c:Character {id: 'CHR_09'}) SET c.nameEn = 'Ontogenetic arrangement change', c.nameTr = 'Büyüme sırasında loca dizilimi değişimi', c.group = 'CORE', c.note = 'Treated separately from the adult chamber arrangement. Example: Spiroplectammina = PLANISPIRAL_TO_BISERIAL.';
MERGE (v:Value {key: 'CHR_09_NONE'}) SET v.code = 'NONE', v.character = 'CHR_09';
MATCH (c:Character {id: 'CHR_09'}), (v:Value {key: 'CHR_09_NONE'}) MERGE (c)-[:ALLOWS]->(v);
