MERGE (c:Character {id: 'CHR_07'}) SET c.nameEn = 'Coiling plane', c.nameTr = 'Sarılım düzlemi', c.group = 'CORE', c.note = 'Example: Ammodiscus = PLANISPIRAL + SINGLE_PLANE; Glomospira = GLOMOSPIRAL/IRREGULAR_COILING + CHANGING_PLANES.';
MERGE (v:Value {key: 'CHR_07_SINGLE_PLANE'}) SET v.code = 'SINGLE_PLANE', v.character = 'CHR_07';
MATCH (c:Character {id: 'CHR_07'}), (v:Value {key: 'CHR_07_SINGLE_PLANE'}) MERGE (c)-[:ALLOWS]->(v);
