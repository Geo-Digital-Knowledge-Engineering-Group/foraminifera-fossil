MERGE (v:Value {key: 'CHR_09_TRISERIAL_TO_UNISERIAL'}) SET v.code = 'TRISERIAL_TO_UNISERIAL', v.character = 'CHR_09';
MATCH (c:Character {id: 'CHR_09'}), (v:Value {key: 'CHR_09_TRISERIAL_TO_UNISERIAL'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_09_COILED_TO_SERIAL'}) SET v.code = 'COILED_TO_SERIAL', v.character = 'CHR_09';
