MERGE (v:Value {key: 'CHR_02_NOT_OBSERVABLE'}) SET v.code = 'NOT_OBSERVABLE', v.character = 'CHR_02', v.labelTr = 'Gözlenemiyor';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_NOT_OBSERVABLE'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_UNCERTAIN'}) SET v.code = 'UNCERTAIN', v.character = 'CHR_02', v.labelTr = 'Emin değilim';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_UNCERTAIN'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (c:Character {id: 'CHR_03'}) SET c.nameEn = 'Septation', c.nameTr = 'Septalarla bölünme', c.group = 'CORE', c.note = 'Determines whether the test contains true chambers separated by septa. A coiled tubular test without true septa must not automatically be interpreted as multichambered.';
MERGE (v:Value {key: 'CHR_03_PRESENT'}) SET v.code = 'PRESENT', v.character = 'CHR_03';
MATCH (c:Character {id: 'CHR_03'}), (v:Value {key: 'CHR_03_PRESENT'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_03_ABSENT'}) SET v.code = 'ABSENT', v.character = 'CHR_03';
MATCH (c:Character {id: 'CHR_03'}), (v:Value {key: 'CHR_03_ABSENT'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_03_NOT_OBSERVABLE'}) SET v.code = 'NOT_OBSERVABLE', v.character = 'CHR_03';
MATCH (c:Character {id: 'CHR_03'}), (v:Value {key: 'CHR_03_NOT_OBSERVABLE'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_03_UNCERTAIN'}) SET v.code = 'UNCERTAIN', v.character = 'CHR_03';
MATCH (c:Character {id: 'CHR_03'}), (v:Value {key: 'CHR_03_UNCERTAIN'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (c:Character {id: 'CHR_04'}) SET c.nameEn = 'Chamber number organization', c.nameTr = 'Loca organizasyonu', c.group = 'CORE', c.note = 'Important for separating undivided tubular agglutinated forms from true multichambered taxa.';
MERGE (v:Value {key: 'CHR_04_UNDIVIDED'}) SET v.code = 'UNDIVIDED', v.character = 'CHR_04', v.labelTr = 'Septalarla bölünmemiş';
MATCH (c:Character {id: 'CHR_04'}), (v:Value {key: 'CHR_04_UNDIVIDED'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_04_MULTICHAMBERED'}) SET v.code = 'MULTICHAMBERED', v.character = 'CHR_04', v.labelTr = 'Çok localı';
MATCH (c:Character {id: 'CHR_04'}), (v:Value {key: 'CHR_04_MULTICHAMBERED'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_04_NOT_OBSERVABLE'}) SET v.code = 'NOT_OBSERVABLE', v.character = 'CHR_04';
MATCH (c:Character {id: 'CHR_04'}), (v:Value {key: 'CHR_04_NOT_OBSERVABLE'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_04_UNCERTAIN'}) SET v.code = 'UNCERTAIN', v.character = 'CHR_04';
MATCH (c:Character {id: 'CHR_04'}), (v:Value {key: 'CHR_04_UNCERTAIN'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (c:Character {id: 'CHR_05'}) SET c.nameEn = 'Chamber arrangement', c.nameTr = 'Loca dizilimi', c.group = 'CORE', c.note = 'PLANISPIRAL, TROCHOSPIRAL and STREPTOSPIRAL must NOT be stored here; they belong to CHR_06 Coiling Pattern.';
MERGE (v:Value {key: 'CHR_05_UNISERIAL'}) SET v.code = 'UNISERIAL', v.character = 'CHR_05';
MATCH (c:Character {id: 'CHR_05'}), (v:Value {key: 'CHR_05_UNISERIAL'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_05_BISERIAL'}) SET v.code = 'BISERIAL', v.character = 'CHR_05';
