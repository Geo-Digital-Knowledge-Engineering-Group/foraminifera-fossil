MERGE (c:Character {id: 'CHR_08'}) SET c.nameEn = 'Involution / evolution', c.nameTr = 'İnvolüt–evolüt sarılım', c.group = 'CORE', c.note = 'Activate only for taxa in which involution/evolution is morphologically meaningful.';
MERGE (v:Value {key: 'CHR_08_INVOLUTE'}) SET v.code = 'INVOLUTE', v.character = 'CHR_08';
