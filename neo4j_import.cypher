// Foram Identification Ontology v1.0 — Neo4j import (idempotent)
// Run in Neo4j Browser or: cat neo4j_import.cypher | cypher-shell -a <aura-uri> -u neo4j -p <pwd>

// ---- constraints ----
CREATE CONSTRAINT genus_name IF NOT EXISTS FOR (g:Genus) REQUIRE g.name IS UNIQUE;
CREATE CONSTRAINT char_id IF NOT EXISTS FOR (c:Character) REQUIRE c.id IS UNIQUE;
CREATE CONSTRAINT value_key IF NOT EXISTS FOR (v:Value) REQUIRE v.key IS UNIQUE;
CREATE CONSTRAINT rule_key IF NOT EXISTS FOR (r:RuleItem) REQUIRE r.key IS UNIQUE;
CREATE CONSTRAINT module_name IF NOT EXISTS FOR (m:Module) REQUIRE m.name IS UNIQUE;
CREATE CONSTRAINT status_name IF NOT EXISTS FOR (s:Status) REQUIRE s.name IS UNIQUE;
CREATE CONSTRAINT obs_name IF NOT EXISTS FOR (o:ObservationState) REQUIRE o.name IS UNIQUE;
CREATE CONSTRAINT q_id IF NOT EXISTS FOR (q:Question) REQUIRE q.id IS UNIQUE;
CREATE CONSTRAINT outcome_id IF NOT EXISTS FOR (o:Outcome) REQUIRE o.id IS UNIQUE;

// ---- modules ----
MERGE (:Module {name: 'AGGLUTINATED'});
MERGE (:Module {name: 'PORCELANEOUS'});
MERGE (:Module {name: 'HYALINE'});

// ---- identification statuses ----
MERGE (:Status {name: 'CONFIRMED_GENUS'});
MERGE (:Status {name: 'PROBABLE_GENUS'});
MERGE (:Status {name: 'CANDIDATE_GENUS'});
MERGE (:Status {name: 'INDETERMINATE'});
MERGE (:Status {name: 'NO_MATCH_WITHIN_CORE_TAXA'});

// ---- global observation states ----
MERGE (o:ObservationState {name: 'PRESENT'}) SET o.labelTr = 'Var', o.note = 'The character is clearly observable in the specimen.';
MERGE (o:ObservationState {name: 'ABSENT'}) SET o.labelTr = 'Yok', o.note = 'Expected to be observable in the available section but clearly absent.';
MERGE (o:ObservationState {name: 'NOT_OBSERVABLE'}) SET o.labelTr = 'Gözlenemiyor', o.note = 'Cannot be reliably evaluated (section orientation, preservation, image quality, incomplete exposure). NOT_OBSERVABLE != ABSENT; must not exclude a genus.';
MERGE (o:ObservationState {name: 'UNCERTAIN'}) SET o.labelTr = 'Emin değilim', o.note = 'Observed area visible but state cannot be confidently determined. Neutral score.';

// ---- characters & controlled vocabulary ----
MERGE (c:Character {id: 'CHR_01'}) SET c.nameEn = 'Test composition', c.nameTr = 'Kavkı bileşimi', c.group = 'CORE', c.note = 'Principal entry character of the identification system.';
MERGE (v:Value {key: 'CHR_01_AGGLUTINATED'}) SET v.code = 'AGGLUTINATED', v.character = 'CHR_01', v.labelTr = 'Aglütinat';
MATCH (c:Character {id: 'CHR_01'}), (v:Value {key: 'CHR_01_AGGLUTINATED'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_01_PORCELANEOUS'}) SET v.code = 'PORCELANEOUS', v.character = 'CHR_01', v.labelTr = 'Porselen';
MATCH (c:Character {id: 'CHR_01'}), (v:Value {key: 'CHR_01_PORCELANEOUS'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_01_HYALINE'}) SET v.code = 'HYALINE', v.character = 'CHR_01', v.labelTr = 'Hyalin';
MATCH (c:Character {id: 'CHR_01'}), (v:Value {key: 'CHR_01_HYALINE'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_01_UNCERTAIN'}) SET v.code = 'UNCERTAIN', v.character = 'CHR_01', v.labelTr = 'Emin değilim';
MATCH (c:Character {id: 'CHR_01'}), (v:Value {key: 'CHR_01_UNCERTAIN'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (c:Character {id: 'CHR_02'}) SET c.nameEn = 'Test shape', c.nameTr = 'Kavkı şekli', c.group = 'CORE', c.note = 'Test shape and coiling must be stored as separate characters.';
MERGE (v:Value {key: 'CHR_02_GLOBULAR'}) SET v.code = 'GLOBULAR', v.character = 'CHR_02', v.labelTr = 'Küresel';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_GLOBULAR'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_SAC_LIKE'}) SET v.code = 'SAC_LIKE', v.character = 'CHR_02', v.labelTr = 'Kese biçimli';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_SAC_LIKE'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_TUBULAR'}) SET v.code = 'TUBULAR', v.character = 'CHR_02', v.labelTr = 'Tübüler';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_TUBULAR'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_ELONGATE'}) SET v.code = 'ELONGATE', v.character = 'CHR_02', v.labelTr = 'Uzamış';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_ELONGATE'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_FUSIFORM'}) SET v.code = 'FUSIFORM', v.character = 'CHR_02', v.labelTr = 'Fusiform / iğ biçimli';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_FUSIFORM'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_OVOID'}) SET v.code = 'OVOID', v.character = 'CHR_02', v.labelTr = 'Ovoid';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_OVOID'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_LENTICULAR'}) SET v.code = 'LENTICULAR', v.character = 'CHR_02', v.labelTr = 'Merceksi';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_LENTICULAR'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_DISCOIDAL'}) SET v.code = 'DISCOIDAL', v.character = 'CHR_02', v.labelTr = 'Diskoidal';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_DISCOIDAL'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_FLATTENED'}) SET v.code = 'FLATTENED', v.character = 'CHR_02', v.labelTr = 'Basık';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_FLATTENED'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_CONICAL'}) SET v.code = 'CONICAL', v.character = 'CHR_02', v.labelTr = 'Konik';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_CONICAL'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_HIGH_CONICAL'}) SET v.code = 'HIGH_CONICAL', v.character = 'CHR_02', v.labelTr = 'Yüksek konik';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_HIGH_CONICAL'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_FLABELLIFORM'}) SET v.code = 'FLABELLIFORM', v.character = 'CHR_02', v.labelTr = 'Yelpaze biçimli';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_FLABELLIFORM'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_STELLATE'}) SET v.code = 'STELLATE', v.character = 'CHR_02', v.labelTr = 'Yıldızsı';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_STELLATE'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_IRREGULAR'}) SET v.code = 'IRREGULAR', v.character = 'CHR_02', v.labelTr = 'Düzensiz';
MATCH (c:Character {id: 'CHR_02'}), (v:Value {key: 'CHR_02_IRREGULAR'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_02_OTHER'}) SET v.code = 'OTHER', v.character = 'CHR_02', v.labelTr = 'Diğer';
