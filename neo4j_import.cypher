MERGE (v:Value {key: 'CHR_05_OTHER'}) SET v.code = 'OTHER', v.character = 'CHR_05';
MATCH (c:Character {id: 'CHR_05'}), (v:Value {key: 'CHR_05_OTHER'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_05_NOT_OBSERVABLE'}) SET v.code = 'NOT_OBSERVABLE', v.character = 'CHR_05';
MATCH (c:Character {id: 'CHR_05'}), (v:Value {key: 'CHR_05_NOT_OBSERVABLE'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_05_UNCERTAIN'}) SET v.code = 'UNCERTAIN', v.character = 'CHR_05';
MATCH (c:Character {id: 'CHR_05'}), (v:Value {key: 'CHR_05_UNCERTAIN'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (c:Character {id: 'CHR_06'}) SET c.nameEn = 'Coiling pattern', c.nameTr = 'Sarılım tipi', c.group = 'CORE';
MERGE (v:Value {key: 'CHR_06_PLANISPIRAL'}) SET v.code = 'PLANISPIRAL', v.character = 'CHR_06';
MATCH (c:Character {id: 'CHR_06'}), (v:Value {key: 'CHR_06_PLANISPIRAL'}) MERGE (c)-[:ALLOWS]->(v);
MERGE (v:Value {key: 'CHR_06_TROCHOSPIRAL'}) SET v.code = 'TROCHOSPIRAL', v.character = 'CHR_06';
